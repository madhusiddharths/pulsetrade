# ─────────────────────────────────────────────────────────────────────────────
# PulseTrade environment — copy to .env and fill in.
#   cp .env.example .env
#
# "REQUIRED TO BOOT" = the API container fails fast at startup (by design —
# api/config.py validates with pydantic) if these are missing.
# NOTE (K8s): when creating the cluster Secret, FILTER OUT the PULSETRADE_PG_* /
# PULSETRADE_API_URL lines so they don't override the ConfigMap — see
# docs/runbook-gke.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM agent (api) — REQUIRED TO BOOT
GOOGLE_API_KEY=            # Gemini 2.5 Flash key — https://aistudio.google.com

# ── Databricks SQL warehouse (api + dashboard + drift) — REQUIRED TO BOOT
DATABRICKS_HOST=           # e.g. dbc-xxxx.cloud.databricks.com (no https://)
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=      # SQL warehouse path, e.g. /sql/1.0/warehouses/xxxx
# DATABRICKS_CATALOG=workspace
# DATABRICKS_SCHEMA=pulsetrade

# ── Agent web search (api MCP tool) — optional; news-search tool degrades without it
TAVILY_API_KEY=

# ── Market data producers (producers/)
FINNHUB_API_KEY=           # https://finnhub.io free tier (see ADR-001)
NEWSAPI_KEY=               # https://newsapi.org free tier

# ── Kafka (Confluent Cloud) — producers + Databricks bronze job
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

# ── LangSmith tracing (api) — optional
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pulsetrade

# ── Optional extras
# GROQ_API_KEY=                                  # alternate LLM (unused by default)
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/Users/<you>/pulsetrade-anomaly-detector

# ── Postgres — sensible defaults are baked into the code for local dev
# (api → localhost:5433; compose and the Helm chart inject their own values).
# Only set these when pointing at a non-default Postgres:
# PULSETRADE_PG_HOST=localhost
# PULSETRADE_PG_PORT=5434
# PULSETRADE_PG_USER=pulsetrade
# PULSETRADE_PG_PASSWORD=pulsetrade
# PULSETRADE_PG_DB=pulsetrade
# PULSETRADE_API_URL=http://localhost:8000       # dashboard → api (compose sets http://api:8000)

# ── Drift job knobs (drift/) — optional demo controls
# DRIFT_INJECT=false
# DRIFT_OUTPUT_DIR=/tmp/drift
